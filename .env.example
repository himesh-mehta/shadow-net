# ==============================================================================
# SHADOW-NET Configuration Template
# ==============================================================================
# Security Notice:
# Never commit actual credentials or production keys to version control.
# Copy this file to .env and configure for your local controlled test environment.
# ==============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/shadow_net

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_secret_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Detection & Model Configuration
DETECTION_THRESHOLD=0.75
MODEL_PATH=../model/resnet18.pth
DEMO_MODE=false

# Audio Pipeline Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_WINDOW_SECONDS=4.0
VAD_SENSITIVITY=2

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Pretrained candidate; download once with python scripts/download_detector.py
DETECTOR_BACKEND=huggingface
HF_MODEL_ID=Gustking/wav2vec2-large-xlsr-deepfake-audio-classification
HF_MODEL_REVISION=f7050b586236dc910d1157f430def2d0647b02b4
HF_LOCAL_FILES_ONLY=true
INFERENCE_DEVICE=cpu
CPU_THREADS=2
